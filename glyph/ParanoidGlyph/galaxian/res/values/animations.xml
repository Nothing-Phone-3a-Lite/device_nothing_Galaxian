<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Animations -->
    <!-- A single Glyph light, so the preview only shows the one "dot" zone. -->
    <string-array name="glyph_settings_animations_slugs" translatable="false">
        <item>dot</item>
    </string-array>
    <integer-array name="glyph_settings_animations_supported_pattern_lengths" translatable="false">
        <item>1</item>
    </integer-array>

    <!-- Battery Animations -->
    <!--
         Galaxian's single on/off Glyph light cannot show a battery level, so
         the charging animation is not exposed on this device.
    -->

    <!-- Call Animations -->
    <string name="glyph_settings_call_animations_default" translatable="false">Beetle (Custom)</string>

    <!-- Notification Animations -->
    <string name="glyph_settings_notifs_animations_default" translatable="false">Beak (Custom)</string>
    <integer name="glyph_settings_notifs_essential_led" translatable="false">0</integer>

    <!-- Volume Animations -->
    <!--
         Galaxian's single on/off Glyph light cannot show a volume level, so
         the volume indicator is not exposed on this device.
    -->

</resources>
