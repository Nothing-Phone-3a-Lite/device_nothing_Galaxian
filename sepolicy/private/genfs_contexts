genfscon proc /sys/net/ipv4/tcp_congestion_control u:object_r:proc_galaxian_tcp_control:s0
genfscon proc /sys/net/ipv4/tcp_available_congestion_control u:object_r:proc_galaxian_tcp_available:s0
# Nodes the platform leaves unlabelled. /sys/vm/dirty_background_ratio, /loadavg
# and /pressure/* already carry platform labels (proc_dirty, proc_loadavg,
# proc_pressure_*); /sys/vm/swappiness is labelled proc_swappiness by the
# MediaTek vendor policy. Relabelling any of them is a duplicate genfs entry.
genfscon proc /sys/vm/dirty_ratio u:object_r:proc_galaxian_tuning:s0
genfscon proc /sys/vm/vfs_cache_pressure u:object_r:proc_galaxian_tuning:s0
genfscon proc /sys/kernel/sched_uclamp_util_min u:object_r:proc_galaxian_tuning:s0
genfscon proc /sys/kernel/sched_uclamp_util_max u:object_r:proc_galaxian_tuning:s0
genfscon proc /sys/kernel/sched_bore u:object_r:proc_galaxian_tuning:s0
