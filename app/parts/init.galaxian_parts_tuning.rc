# SPDX-License-Identifier: Apache-2.0

# Advertise the controls only after init has loaded this file. Keep kernel defaults.
# /proc/sys/vm/swappiness is owned by the MediaTek vendor policy (proc_swappiness,
# writable by vendor_init), so it is deliberately not part of these presets.
on property:sys.boot_completed=1
    setprop sys.galaxianparts.tuning_ready 1

on property:sys.galaxianparts.vm_profile=stock
    write /proc/sys/vm/dirty_ratio 20
    write /proc/sys/vm/dirty_background_ratio 10
    write /proc/sys/vm/vfs_cache_pressure 100

on property:sys.galaxianparts.vm_profile=balanced
    write /proc/sys/vm/dirty_ratio 15
    write /proc/sys/vm/dirty_background_ratio 5
    write /proc/sys/vm/vfs_cache_pressure 80

on property:sys.galaxianparts.vm_profile=performance
    write /proc/sys/vm/dirty_ratio 20
    write /proc/sys/vm/dirty_background_ratio 10
    write /proc/sys/vm/vfs_cache_pressure 50

on property:sys.galaxianparts.vm_profile=battery
    write /proc/sys/vm/dirty_ratio 10
    write /proc/sys/vm/dirty_background_ratio 5
    write /proc/sys/vm/vfs_cache_pressure 150

on property:sys.galaxianparts.uclamp_profile=default
    write /proc/sys/kernel/sched_uclamp_util_min 0
    write /proc/sys/kernel/sched_uclamp_util_max 1024

on property:sys.galaxianparts.uclamp_profile=battery
    write /proc/sys/kernel/sched_uclamp_util_min 0
    write /proc/sys/kernel/sched_uclamp_util_max 512

on property:sys.galaxianparts.uclamp_profile=performance
    write /proc/sys/kernel/sched_uclamp_util_min 128
    write /proc/sys/kernel/sched_uclamp_util_max 1024
